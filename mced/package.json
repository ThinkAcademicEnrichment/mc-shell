{
  "name": "mc-ed",
  "version": "1.0.0",
  "description": "Minecraft Blockly Editor",
  "source": "src/index.html",
  "scripts": {
    "clean": "rimraf ../mcshell/data/app",
    "build:all": "poetry run python ../build.py",
    "build:app":"parcel build src/index.html src/control.html --dist-dir ../mcshell/data/app --no-cache",
    "build": "npm run clean && npm run build:all && npm run build:app"
  },
  "dependencies": {
    "alpinejs": "^3.14.9",
    "blockly": "^12.2.0",
    "htmx-ext-json-enc": "^2.0.2",
    "htmx.org": "^2.0.6",
    "prismjs": "^1.30.0",
    "simple-keyboard": "^3.8.93",
    "socket.io-client": "^4.8.1",
    "sortablejs": "^1.15.6"
  },
  "devDependencies": {
    "@parcel/packager-xml": "^2.16.3",
    "@parcel/transformer-xml": "^2.16.3",
    "parcel": "^2.12.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "rimraf": "^6.0.1"
  },
  "targets": {
    "default": {
      "context": "browser"
    }
  }
}
